generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DENTISTA
  RECEPCIONISTA
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  role         Role          @default(DENTISTA)
  commission   Float         @default(40.0)
  isActive     Boolean       @default(true)

  specialtyId  String?
  specialty    Specialty?    @relation(fields: [specialtyId], references: [id])

  appointments Appointment[]
  budgets      Budget[]
  payrolls     Payroll[]
  createdAt    DateTime      @default(now())
}

model Patient {
  id           String           @id @default(uuid())
  rut          String           @unique
  firstName    String
  lastName     String
  email        String?          @unique
  phone        String?
  odontogram   Json?

  insuranceId  String?
  insurance    HealthInsurance? @relation(fields: [insuranceId], references: [id])

  appointments Appointment[]
  budgets      Budget[]
  createdAt    DateTime         @default(now())
  fonasaVouchers    FonasaVoucher[]
  agreements        AgreementMember[]
  agreementContracts AgreementContract[]
}

model Appointment {
  id                String           @id @default(uuid())
  date              DateTime
  duration          Int              @default(30)
  status            String           @default("AGENDADO")
  notes             String?

  patientId         String
  patient           Patient          @relation(fields: [patientId], references: [id])

  dentistId         String
  dentist           User             @relation(fields: [dentistId], references: [id])

  boxId             String?
  box               Box?             @relation(fields: [boxId], references: [id])

  appointmentTypeId String?
  appointmentType   AppointmentType? @relation(fields: [appointmentTypeId], references: [id])

  createdAt         DateTime         @default(now())
}

model Treatment {
  id          String             @id @default(uuid())
  name        String
  price       Int
  isActive    Boolean            @default(true)

  categoryId  String?
  category    ProcedureCategory? @relation(fields: [categoryId], references: [id])

  items       BudgetItem[]
  fonasaVouchers FonasaVoucher[]
}

model Budget {
  id        String       @id @default(uuid())
  total     Int          @default(0)
  paid      Int          @default(0)
  status    String       @default("PENDIENTE")

  patientId String
  patient   Patient      @relation(fields: [patientId], references: [id])

  dentistId String
  dentist   User         @relation(fields: [dentistId], references: [id])

  items     BudgetItem[]
  payments  Payment[]
  createdAt DateTime     @default(now())
}

model Payment {
  id              String         @id @default(uuid())
  amount          Int

  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  budgetId        String
  budget          Budget         @relation(fields: [budgetId], references: [id])

  createdAt       DateTime       @default(now())
}

model BudgetItem {
  id          String     @id @default(uuid())
  tooth       Int?
  price       Int

  budgetId    String
  budget      Budget     @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  treatmentId String
  treatment   Treatment  @relation(fields: [treatmentId], references: [id])

  // Relación con liquidación (para no liquidar dos veces)
  payrollId   String?
  payroll     Payroll?   @relation(fields: [payrollId], references: [id])
}

enum PayrollStatus {
  BORRADOR
  CALCULADA
  APROBADA
  PAGADA
  ANULADA
}

model Payroll {
  id               String         @id @default(uuid())
  period           String         // Ej: "2026-03" o "Marzo 2026"
  status           PayrollStatus  @default(BORRADOR)

  dentistId        String
  dentist          User           @relation(fields: [dentistId], references: [id])

  // Porcentajes (deben sumar 100%)
  dentistRate      Float          // Ej: 40.0
  clinicRate       Float          // Ej: 60.0

  // Desglose financiero
  totalProduced    Int            @default(0) // Total recaudado en prestaciones
  bonusAmount      Int            @default(0) // Bonificaciones (+)
  adjustmentAmount Int            @default(0) // Ajustes (+ o -)
  discountAmount   Int            @default(0) // Descuentos (-)

  totalDentist     Int            @default(0) // Total a pagar al profesional
  totalClinic      Int            @default(0) // Ganancia clínica

  notes            String?
  items            BudgetItem[]   // Detalle de prestaciones incluidas

  closedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ==========================================
// MÓDULO 5.1: DATOS MAESTROS (AXEL)
// ==========================================

model Specialty {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Box {
  id           String        @id @default(uuid())
  name         String        @unique
  isActive     Boolean       @default(true)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model HealthInsurance {
  id        String    @id @default(uuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  patients  Patient[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PaymentMethod {
  id        String    @id @default(uuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  payments  Payment[]
  cashMovements CashMovement[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AppointmentType {
  id           String        @id @default(uuid())
  name         String        @unique
  isActive     Boolean       @default(true)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ProcedureCategory {
  id         String      @id @default(uuid())
  name       String      @unique
  isActive   Boolean     @default(true)
  treatments Treatment[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model SystemParameter {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  entityName String
  entityId   String
  action     String
  oldValue   String?
  newValue   String?
  changedBy  String?
  createdAt  DateTime @default(now())
}

// ==========================================
// MÓDULO 5.2: CAJA (AXEL)
// ==========================================

enum CashSessionStatus {
  ABIERTA
  CERRADA
}

enum CashMovementType {
  INGRESO
  EGRESO
}

// Sesión de Caja (Apertura, Cierre, Arqueo)
model CashSession {
  id              String            @id @default(uuid())
  status          CashSessionStatus @default(ABIERTA)
  
  // Apertura
  initialAmount   Int               // Monto inicial en efectivo
  openedAt        DateTime          @default(now())
  openedBy        String            // Nombre o email del responsable
  
  // Cierre y Arqueo
  closedAt        DateTime?
  closedBy        String?
  expectedAmount  Int?              // Monto teórico calculado
  countedAmount   Int?              // Monto real contado físicamente
  difference      Int?              // countedAmount - expectedAmount (sobrante o faltante)
  differenceNotes String?           // Justificación de la diferencia
  
  movements       CashMovement[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

// Movimientos de Caja (Ingresos y Egresos)
model CashMovement {
  id              String           @id @default(uuid())
  type            CashMovementType
  amount          Int
  description     String
  
  // Método de pago (asociado al dato maestro)
  paymentMethodId String
  paymentMethod   PaymentMethod    @relation(fields: [paymentMethodId], references: [id])
  
  // Regla: No eliminar, solo anular
  isVoided        Boolean          @default(false)
  voidReason      String?
  voidedBy        String?
  voidedAt        DateTime?
  
  registeredBy    String           // Responsable del movimiento
  
  sessionId       String
  session         CashSession      @relation(fields: [sessionId], references: [id])
  
  createdAt       DateTime         @default(now())
}

// ==========================================
// MÓDULO 5.4: FONASA Y CONVENIOS (AXEL)
// ==========================================

enum FonasaVoucherStatus {
  PENDIENTE
  UTILIZADO
  ANULADO
}

// 1. Bonos FONASA
model FonasaVoucher {
  id              String              @id @default(uuid())
  folio           String              @unique // Regla: Folio único, no reutilizable
  status          FonasaVoucherStatus @default(PENDIENTE)
  amount          Int                 // Monto bonificado por FONASA
  copayment       Int                 @default(0) // Copago del paciente si aplica

  // Regla: Asociado a paciente existente y prestación válida
  patientId       String
  patient         Patient             @relation(fields: [patientId], references: [id])

  treatmentId     String
  treatment       Treatment           @relation(fields: [treatmentId], references: [id])

  usedAt          DateTime?
  voidReason      String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

// 2. Convenios (Empresas y Sindicatos)
model Agreement {
  id            String             @id @default(uuid())
  name          String             @unique // Ej: "Sindicato Minera Los Pelambres"
  institution   String             // Empresa o Sindicato
  discountPct   Float              @default(0.0) // Porcentaje de descuento aplicado
  startDate     DateTime
  endDate       DateTime?
  isActive      Boolean            @default(true) // Vigencia

  beneficiaries AgreementMember[]
  contracts     AgreementContract[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

// Beneficiarios adscritos a un convenio
model AgreementMember {
  id          String    @id @default(uuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id])

  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id])

  joinedAt    DateTime  @default(now())

  @@unique([agreementId, patientId]) // Un paciente no se duplica en el mismo convenio
}

// Contratos de pago en cuotas por convenio
model AgreementContract {
  id          String          @id @default(uuid())
  totalAmount Int             // Monto total pactado
  installmentsCount Int       // Número de cuotas

  agreementId String
  agreement   Agreement       @relation(fields: [agreementId], references: [id])

  patientId   String
  patient     Patient         @relation(fields: [patientId], references: [id])

  installments AgreementInstallment[]
  createdAt   DateTime        @default(now())
}

// Cuotas asociadas a un contrato de convenio
model AgreementInstallment {
  id          String            @id @default(uuid())
  number      Int               // Número de cuota (1, 2, 3...)
  amount      Int               // Monto de la cuota
  dueDate     DateTime          // Fecha de vencimiento
  isPaid      Boolean           @default(false)
  paidAt      DateTime?

  contractId  String
  contract    AgreementContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}