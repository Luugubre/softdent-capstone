generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DENTISTA
  RECEPCIONISTA
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  role         Role          @default(DENTISTA)
  commission   Float         @default(40.0)
  
  appointments Appointment[]
  budgets      Budget[]
  payrolls     Payroll[]
  createdAt    DateTime      @default(now())
}

model Patient {
  id           String        @id @default(uuid())
  rut          String        @unique
  firstName    String
  lastName     String
  phone        String?
  odontogram   Json?
  appointments Appointment[]
  budgets      Budget[]
  createdAt    DateTime      @default(now())
}

model Appointment {
  id           String   @id @default(uuid())
  date         DateTime // Fecha y hora exacta de la cita
  duration     Int      @default(30) // Duración en minutos
  status       String   @default("AGENDADO") // AGENDADO, EN_ESPERA, EN_BOX, ATENDIDO, NO_ASISTE
  notes        String?  // Motivo de consulta o nota de recepción

  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])

  dentistId    String
  dentist      User     @relation(fields: [dentistId], references: [id])

  createdAt    DateTime @default(now())
}

// --- TABLAS DE PRESUPUESTO ---

model Treatment {
  id          String       @id @default(uuid())
  name        String
  price       Int
  category    String
  items       BudgetItem[]
}

model Budget {
  id          String       @id @default(uuid())
  total       Int          @default(0)
  paid        Int          @default(0)
  status      String       @default("PENDIENTE") // PENDIENTE, APROBADO, PAGADO
  
  patientId   String
  patient     Patient      @relation(fields: [patientId], references: [id])
  
  dentistId   String
  dentist     User         @relation(fields: [dentistId], references: [id])
  
  items       BudgetItem[]
  payments    Payment[]
  createdAt   DateTime     @default(now())
}

// Registro de Pagos
model Payment {
  id          String   @id @default(uuid())
  amount      Int
  method      String
  
  budgetId    String
  budget      Budget   @relation(fields: [budgetId], references: [id])
  
  createdAt   DateTime @default(now())
}

model BudgetItem {
  id          String     @id @default(uuid())
  tooth       Int?
  price       Int
  
  budgetId    String
  budget      Budget     @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  
  treatmentId String
  treatment   Treatment  @relation(fields: [treatmentId], references: [id])
}

// Liquidaciones de sueldo/honorarios
model Payroll {
  id          String    @id @default(uuid())
  period      String    // Mes a liquidar (ej: "2026-09")
  totalPaid   Int       
  status      String    @default("BORRADOR") // BORRADOR, CERRADA
  closedAt    DateTime? // Fecha y hora exacta en que se cerró el mes
  
  dentistId   String
  dentist     User      @relation(fields: [dentistId], references: [id])
  
  createdAt   DateTime  @default(now())
}